# ==============================================================================
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control!
# ==============================================================================

# --- CORE ---
# Keep DEBUG=False in production — True leaks stack traces to the public.
DEBUG=True
SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- DATABASE ---
{% if cookiecutter.database_type == 'postgres' -%}
# If using Docker, use the service name (e.g., postgres://user:pass@db:5432/...)
DATABASE_URL=postgres://user:password@localhost:5432/{{ cookiecutter.project_slug }}
CONN_MAX_AGE=60
{%- else -%}
# SQLite is used by default when DATABASE_URL is not set.
# To override: DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3
{%- endif %}

# --- EMAIL ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=you@example.com

# --- LOGGING ---
# DJANGO_LOG_LEVEL=WARNING

{% if cookiecutter.use_celery == 'yes' -%}
# --- CELERY ---
# If using Docker, use redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
{%- endif %}

{% if cookiecutter.use_allauth == 'yes' -%}
# --- ALLAUTH ---
ACCOUNT_ALLOW_REGISTRATION=True
# Set to 'https' in production
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http
{%- endif %}

# --- PRODUCTION CHECKLIST ---
# 1. DEBUG=False
# 2. ALLOWED_HOSTS=yourdomain.com
# 3. SECURE_SSL_REDIRECT=True
# 4. SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https (if behind Nginx/Heroku)
# 5. EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend